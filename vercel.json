{
  "rewrites": [
    { "source": "/essays/:slug", "destination": "/essays/:slug/index.html" },
    { "source": "/zh/essays/:slug", "destination": "/zh/essays/:slug/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/zh/about", "destination": "/zh/about/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
