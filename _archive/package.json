{
  "name": "charlie-feng-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate-metadata && vite",
    "build": "npm run generate-metadata && vite build && npm run generate-static-pages && npm run generate-sitemap",
    "generate-metadata": "npx tsx scripts/generate_metadata.ts",
    "generate-static-pages": "npx tsx scripts/generate_static_pages.ts",
    "generate-sitemap": "npx tsx scripts/generate_sitemap.ts",
    "preview": "vite preview",
    "test": "npx tsx --test --experimental-test-module-mocks tests/*.ts",
    "test:coverage": "c8 --include='lib/**' --include='services/**' --include='hooks/**' npx tsx --test --experimental-test-module-mocks tests/*.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^1.34.0",
    "@types/uuid": "^10.0.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.34.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rss-parser": "^3.13.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "c8": "^10.1.3",
    "front-matter": "^4.0.2",
    "marked": "^17.0.3",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
